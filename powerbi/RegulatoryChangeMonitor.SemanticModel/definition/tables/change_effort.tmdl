		lineageTag: 1825e740-a7eb-566f-b907-f9e8fdc37e81

	partition change_effort = m
		mode: import
		source =
				let
				    Raw = if Source = "Databricks" then Databricks.Catalogs(DatabricksHost, DatabricksHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]){[Name = DatabricksCatalog, Kind = "Database"]}[Data]{[Name = "rcm_gold", Kind = "Schema"]}[Data]{[Name = "change_effort", Kind = "Table"]}[Data]
				          else Table.PromoteHeaders(Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = "brianphu2310/Regulartory_Change_Monitor/" & Branch & "/" & Dataset & "/change_effort.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),
				    Picked = Table.SelectColumns(Raw, {"id", "role", "one_off_hours", "ongoing_hours_yr", "one_off_cost", "ongoing_cost_yr", "department", "hourly_cost"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Picked, {{"id", type text}, {"role", type text}, {"one_off_hours", type number}, {"ongoing_hours_yr", type number}, {"one_off_cost", type number}, {"ongoing_cost_yr", type number}, {"department", type text}, {"hourly_cost", type number}}, "en-AU")
				in
				    Typed
