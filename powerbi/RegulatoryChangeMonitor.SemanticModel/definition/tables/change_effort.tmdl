table change_effort
	lineageTag: 403e95d4-f551-5eb1-b1a0-a7e6102a539f

	measure 'Outstanding Role Hours' = CALCULATE ( SUM ( change_effort[one_off_hours] ), dashboard_changes[work_status] = "Outstanding" )
