	column 'Days To Deadline' = VAR t = COALESCE ( MAXX ( ALL ( dashboard_changes ), dashboard_changes[as_of] ), TODAY () ) RETURN IF ( ISBLANK ( changes[deadline] ), BLANK (), DATEDIFF ( t, changes[deadline], DAY ) )
		dataType: int64
		summarizeBy: none
		lineageTag: 633b2d68-7dd4-5420-add2-8832847ae879

	column 'Deadline Bucket' = VAR t = COALESCE ( MAXX ( ALL ( dashboard_changes ), dashboard_changes[as_of] ), TODAY () ) RETURN IF ( ISBLANK ( changes[deadline] ), "No fixed date", IF ( changes[deadline] < t, "Overdue", IF ( changes[deadline] <= t + 30, "Due in 30 days", "Later" ) ) )
		dataType: string
		summarizeBy: none
		lineageTag: 070362e1-868b-52b8-b07e-c8ebce938b45

	partition changes = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = "brianphu2310/Regulartory_Change_Monitor/" & Branch & "/" & Dataset & "/changes.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),
				    Picked = Table.SelectColumns(Raw, {"id", "published", "source", "title", "summary", "link", "impact", "action_req", "deadline", "status", "impact_sort", "data_type", "topics", "audiences"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Picked, {{"id", type text}, {"published", type date}, {"source", type text}, {"title", type text}, {"summary", type text}, {"link", type text}, {"impact", type text}, {"action_req", Int64.Type}, {"deadline", type date}, {"status", type text}, {"impact_sort", Int64.Type}, {"data_type", type text}, {"topics", type text}, {"audiences", type text}}, "en-AU")
				in
				    Typed
