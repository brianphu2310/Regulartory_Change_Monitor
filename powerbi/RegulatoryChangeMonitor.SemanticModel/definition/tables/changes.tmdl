table changes
	lineageTag: a1dc5a75-528c-51d8-8d46-307ac1e5392f

	measure 'As Of Date' = COALESCE ( MAXX ( ALL ( dashboard_changes ), dashboard_changes[as_of] ), TODAY () )
		formatString: d mmm yyyy
		displayFolder: Labels
		lineageTag: 2a975ff8-ab2e-5eba-9e31-36a93a486043

	measure 'Total Changes' = COUNTROWS ( changes )
		formatString: #,0
		displayFolder: Counts
		lineageTag: 54414bc3-2464-5453-93da-3efcc69f2014

	measure 'High Impact' = CALCULATE ( [Total Changes], changes[impact] = "High" )
		formatString: #,0
		displayFolder: Counts
		lineageTag: 017d56cf-a774-53f4-8894-b7521b6ed38c

	measure 'Open Actions' = CALCULATE ( [Total Changes], changes[action_req] = 1, changes[status] <> "Actioned" )
		formatString: #,0
		displayFolder: Actions
		lineageTag: b51b2a48-96d7-5a67-bed5-02929fa9b093

	measure 'Due In 30 Days' = VAR t = [As Of Date] RETURN CALCULATE ( [Open Actions], FILTER ( ALL ( changes[deadline] ), NOT ISBLANK ( changes[deadline] ) && changes[deadline] >= t && changes[deadline] <= t + 30 ) )
		formatString: #,0
		displayFolder: Actions
		lineageTag: 3c82965a-1aaf-5bc3-b41f-9d55ebe4a788

	measure 'Overdue Actions' = VAR t = [As Of Date] RETURN CALCULATE ( [Open Actions], FILTER ( ALL ( changes[deadline] ), NOT ISBLANK ( changes[deadline] ) && changes[deadline] < t ) )
		formatString: #,0
		displayFolder: Actions
		lineageTag: 5aafad7d-b95e-5481-808b-ba4448db219c

	measure 'Action Rate' = DIVIDE ( [Open Actions], [Total Changes] )
		formatString: 0%
		displayFolder: Actions
		lineageTag: cb21d11d-430d-548e-931b-85044c4e6b12

	measure 'Changes Last 30 Days' = VAR t = [As Of Date] RETURN CALCULATE ( [Total Changes], FILTER ( ALL ( changes[published] ), changes[published] > t - 30 && changes[published] <= t ) )
		formatString: #,0
		displayFolder: Trend
		lineageTag: 28db887a-e517-5f37-b81c-48fb93643e41

	measure 'Changes Prior 30 Days' = VAR t = [As Of Date] RETURN CALCULATE ( [Total Changes], FILTER ( ALL ( changes[published] ), changes[published] > t - 60 && changes[published] <= t - 30 ) )
		formatString: #,0
		displayFolder: Trend
		lineageTag: 5ce30c14-36fb-5054-99d2-896f1dc46792

	measure 'Change vs Prior 30 Days' = DIVIDE ( [Changes Last 30 Days] - [Changes Prior 30 Days], [Changes Prior 30 Days] )
		formatString: 0%
		displayFolder: Trend
		lineageTag: 43eaceee-349c-56bf-91a2-75c6d1e04e15

	measure 'Sample Data Note' = IF ( MAX ( changes[data_type] ) = "Live", "Live data from the weekly monitor. Keyword classification, not legal advice.", "Synthetic sample data. Keyword classification, not legal advice." )
		displayFolder: Labels
		lineageTag: 0163f79b-e3b2-5e84-975c-910fad4b2b45

	measure 'Deadline Color' = VAR d = MIN ( changes[Days To Deadline] ) RETURN IF ( ISBLANK ( d ), BLANK (), IF ( d >= 9999, "#8A97A5", IF ( d < 0, "#C0392B", IF ( d <= 30, "#D98E04", "#1F2933" ) ) ) )
		lineageTag: 812f9d20-db40-560d-ad9a-481f799ed44d

	measure 'Heat Color' = VAR n = [Total Changes] RETURN IF ( ISBLANK ( n ), BLANK (), IF ( n <= 10, "#F1F7DA", IF ( n <= 25, "#DDEBA6", IF ( n <= 45, "#C8E070", "#A9CF3A" ) ) ) )
		lineageTag: 527dcfe6-0e36-5a04-8950-867abcfaedd2

