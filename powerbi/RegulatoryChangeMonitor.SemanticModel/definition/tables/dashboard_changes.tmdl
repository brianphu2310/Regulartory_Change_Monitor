	partition dashboard_changes = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = "brianphu2310/Regulartory_Change_Monitor/" & Branch & "/" & Dataset & "/dashboard_changes.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),
				    Picked = Table.SelectColumns(Raw, {"id", "source", "title", "link", "impact", "impact_sort", "topics", "status", "action_req", "published", "deadline", "one_off_hours", "ongoing_hours_yr", "external_one_off", "external_ongoing_yr", "internal_one_off_cost", "internal_ongoing_cost_yr", "total_one_off_cost", "total_ongoing_cost_yr", "target_date", "lead_time_days", "days_left", "work_status", "outstanding_hours", "at_risk", "as_of", "first_seen", "lead_role", "lead_department"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Picked, {{"id", type text}, {"source", type text}, {"title", type text}, {"link", type text}, {"impact", type text}, {"impact_sort", Int64.Type}, {"topics", type text}, {"status", type text}, {"action_req", Int64.Type}, {"published", type date}, {"deadline", type date}, {"one_off_hours", type number}, {"ongoing_hours_yr", type number}, {"external_one_off", type number}, {"external_ongoing_yr", type number}, {"internal_one_off_cost", type number}, {"internal_ongoing_cost_yr", type number}, {"total_one_off_cost", type number}, {"total_ongoing_cost_yr", type number}, {"target_date", type date}, {"lead_time_days", Int64.Type}, {"days_left", Int64.Type}, {"work_status", type text}, {"outstanding_hours", type number}, {"at_risk", Int64.Type}, {"as_of", type date}, {"first_seen", type date}, {"lead_role", type text}, {"lead_department", type text}}, "en-AU")
				in
				    Typed
