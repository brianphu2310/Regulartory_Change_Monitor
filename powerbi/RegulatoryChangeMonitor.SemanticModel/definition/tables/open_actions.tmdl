	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: [Status]
		lineageTag: 179be940-e745-510d-b191-380777112c4f

	column 'Days Left' = IF ( ISBLANK ( open_actions[Days To Deadline] ), 9999, open_actions[Days To Deadline] )
		dataType: int64
		summarizeBy: none
		lineageTag: 32812197-7321-5274-a70d-67273bc08f52

	partition open_actions = calculated
		mode: import
		source = SELECTCOLUMNS ( FILTER ( changes, changes[action_req] = 1 && changes[status] <> "Actioned" ), "Title", changes[title], "Agency", changes[source], "Impact", changes[impact], "Deadline", changes[deadline], "Days To Deadline", changes[Days To Deadline], "Status", changes[status] )
