table weekly_snapshot
	lineageTag: 8c0a3bc3-1c67-52c9-a076-44d523717cb0

	measure 'Weekly Runs' = COUNTROWS ( weekly_snapshot ) + 0
		formatString: #,0
		lineageTag: 1ae68265-818a-59f9-a074-51ace6880f85

	measure 'Latest Run' = MAX ( weekly_snapshot[run_date] )
		formatString: d mmm yyyy
		lineageTag: 4d669b78-7afb-514b-91e4-e0e8c78d31bf

	measure 'Changes On File (run)' = VAR d = MAX ( weekly_snapshot[run_date] ) RETURN CALCULATE ( SUM ( weekly_snapshot[changes_on_file] ), weekly_snapshot[run_date] = d )
		formatString: #,0
		lineageTag: 2027a575-d492-53b6-9d26-83e69b14139e

	measure 'New Changes (run)' = SUM ( weekly_snapshot[new_this_run] )
		formatString: #,0
		lineageTag: acaa1f1c-05bf-57f1-a253-9349c2c8fcea

	measure 'Needs Action (run)' = VAR d = MAX ( weekly_snapshot[run_date] ) RETURN CALCULATE ( SUM ( weekly_snapshot[needs_action] ), weekly_snapshot[run_date] = d )
		formatString: #,0
		lineageTag: 1fe958bf-32a6-58a4-9a51-94b111b2cd7e

	measure 'Past Target (run)' = VAR d = MAX ( weekly_snapshot[run_date] ) RETURN CALCULATE ( SUM ( weekly_snapshot[past_target_date] ), weekly_snapshot[run_date] = d )
		formatString: #,0
		lineageTag: 65d867ac-6b05-51dd-8aba-382d00d65e62

	measure 'Backlog Hours (run)' = VAR d = MAX ( weekly_snapshot[run_date] ) RETURN CALCULATE ( SUM ( weekly_snapshot[backlog_hours] ), weekly_snapshot[run_date] = d )
		formatString: #,0
		lineageTag: d3c11f52-5b8a-56ce-9d6f-be6949998cd3

	measure 'Backlog vs 4 Weeks' = VAR d = MAX ( weekly_snapshot[run_date] ) VAR p = CALCULATE ( MAX ( weekly_snapshot[run_date] ), ALL ( weekly_snapshot ), weekly_snapshot[run_date] <= d - 28 ) RETURN IF ( ISBLANK ( p ), BLANK (), [Backlog Hours (run)] - CALCULATE ( SUM ( weekly_snapshot[backlog_hours] ), ALL ( weekly_snapshot ), weekly_snapshot[run_date] = p ) )
		formatString: +#,0;-#,0;0
		lineageTag: 4d9bc596-8a0e-508e-9e5b-5d1bb4178d2f

	measure 'Trend Takeaway' = VAR d = MAX ( weekly_snapshot[run_date] ) VAR p = CALCULATE ( MAX ( weekly_snapshot[run_date] ), ALL ( weekly_snapshot ), weekly_snapshot[run_date] <= d - 28 ) VAR late_then = CALCULATE ( SUM ( weekly_snapshot[past_target_date] ), ALL ( weekly_snapshot ), weekly_snapshot[run_date] = p ) RETURN IF ( [Weekly Runs] = 0, "No weekly history yet: it builds up from the first Databricks load.", "Backlog " & FORMAT ( [Backlog Hours (run)], "#,0" ) & " hours, " & IF ( [Backlog vs 4 Weeks] >= 0, "up ", "down " ) & FORMAT ( ABS ( [Backlog vs 4 Weeks] ), "#,0" ) & " in four weeks; " & FORMAT ( [Past Target (run)], "0" ) & " changes past their target date (" & FORMAT ( late_then, "0" ) & " four weeks earlier)." )
		lineageTag: cb4a108d-8614-5c55-9d9f-08ec61289a57

	column run_date
		dataType: dateTime
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: run_date
		lineageTag: 55f529ce-e03d-59a7-b61e-07ac4aaf4512

	column changes_on_file
