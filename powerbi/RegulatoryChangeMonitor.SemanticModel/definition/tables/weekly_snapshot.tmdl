		sourceColumn: sources_ok
		lineageTag: a35ea301-9b56-5a1c-b39c-b42d1ad2bb0b

	partition weekly_snapshot = m
		mode: import
		source =
				let
				    Raw = if Source = "Databricks" then Databricks.Catalogs(DatabricksHost, DatabricksHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]){[Name = DatabricksCatalog, Kind = "Database"]}[Data]{[Name = "rcm_gold", Kind = "Schema"]}[Data]{[Name = "weekly_snapshot", Kind = "Table"]}[Data]
				          else try Table.Buffer(Table.PromoteHeaders(Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = "brianphu2310/Regulartory_Change_Monitor/" & Branch & "/" & Dataset & "/weekly_snapshot.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])) otherwise #table(type table [run_date = text, changes_on_file = text, new_this_run = text, high_impact = text, needs_action = text, past_target_date = text, one_off_cost = text, ongoing_cost_yr = text, backlog_hours = text, peak_month_load = text, sources_checked = text, sources_ok = text], {}),
				    Picked = Table.SelectColumns(Raw, {"run_date", "changes_on_file", "new_this_run", "high_impact", "needs_action", "past_target_date", "one_off_cost", "ongoing_cost_yr", "backlog_hours", "peak_month_load", "sources_checked", "sources_ok"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Picked, {{"run_date", type date}, {"changes_on_file", Int64.Type}, {"new_this_run", Int64.Type}, {"high_impact", Int64.Type}, {"needs_action", Int64.Type}, {"past_target_date", Int64.Type}, {"one_off_cost", type number}, {"ongoing_cost_yr", type number}, {"backlog_hours", type number}, {"peak_month_load", type number}, {"sources_checked", Int64.Type}, {"sources_ok", Int64.Type}}, "en-AU")
				in
				    Typed
