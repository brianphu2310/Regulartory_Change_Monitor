	partition change_effort = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = "brianphu2310/Regulartory_Change_Monitor/" & Branch & "/" & Dataset & "/change_effort.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Raw, {{"id", type text}, {"role", type text}, {"one_off_hours", type number}, {"ongoing_hours_yr", type number}, {"one_off_cost", type number}, {"ongoing_cost_yr", type number}, {"department", type text}, {"hourly_cost", type number}}, "en-AU")
				in
				    Typed
