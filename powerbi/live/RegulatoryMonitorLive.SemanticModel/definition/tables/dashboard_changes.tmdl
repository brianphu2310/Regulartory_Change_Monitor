table dashboard_changes
	lineageTag: 2bddbcad-fedc-58c5-8b76-4b323985d7f3

	measure 'Changes' = COUNTROWS ( dashboard_changes ) + 0
		formatString: #,0
		lineageTag: 54f875e9-d02b-572d-b602-ae0c77c2e5f9

	measure 'New This Week' = VAR asOf = MAX ( dashboard_changes[as_of] ) RETURN CALCULATE ( COUNTROWS ( dashboard_changes ), dashboard_changes[first_seen] > asOf - 7 ) + 0
		formatString: #,0
		lineageTag: 48fabd65-8a04-5f0b-8fa8-20eb724b9abc

	measure 'Needs Action' = CALCULATE ( COUNTROWS ( dashboard_changes ), dashboard_changes[work_status] = "Outstanding" ) + 0
		formatString: #,0
		lineageTag: 8f4de4dd-c930-57e8-80dc-8ca32912f9d9

	measure 'Past Target Date' = CALCULATE ( COUNTROWS ( dashboard_changes ), dashboard_changes[work_status] = "Outstanding", dashboard_changes[days_left] < 0 ) + 0
		formatString: #,0
		lineageTag: 4b5588fd-bd79-5205-b8ef-9592c6236529

	measure 'One-off Cost' = SUM ( dashboard_changes[total_one_off_cost] )
		formatString: \$#,0
		lineageTag: fa7e7804-d450-542b-81da-53776af6d486

	measure 'Staff Time Cost' = SUM ( dashboard_changes[internal_one_off_cost] )
		formatString: \$#,0
		lineageTag: 40927398-e761-507f-98ff-962e8b277896

	measure 'External Cost' = SUM ( dashboard_changes[external_one_off] )
		formatString: \$#,0
		lineageTag: 92c64012-c2ef-5dee-9658-1b228bee478d

	measure 'Ongoing Cost / yr' = SUM ( dashboard_changes[total_ongoing_cost_yr] )
		formatString: \$#,0
		lineageTag: 65854f7f-f2ce-5897-9ff7-33c372ba00ed

	measure 'Backlog Hours' = SUM ( dashboard_changes[outstanding_hours] )
		formatString: #,0
		lineageTag: e83321f5-b01d-57a6-924c-b82dbf90b00d

	measure 'Data As At' = "Data as at " & FORMAT ( MAX ( dashboard_changes[as_of] ), "d mmm yyyy" )
		lineageTag: dbe65d96-82f2-5498-a93f-e34d79c8cc40

	measure 'Takeaway' = "The changes on file cost about " & FORMAT ( [One-off Cost], "$#,0" ) & " once and " & FORMAT ( [Ongoing Cost / yr], "$#,0" ) & " a year. " & FORMAT ( [Past Target Date], "0" ) & " are past their target date and the backlog is " & FORMAT ( [Backlog Hours], "#,0" ) & " staff hours."
		lineageTag: 2204dfa1-7f39-5cd2-9f3c-dcc9bc6e53d8

	measure 'Days Left Colour' = VAR d = MAX ( dashboard_changes[days_left] ) RETURN SWITCH ( TRUE (), d < 0, "#C0392B", d < 14, "#D98C00", "#1F2933" )
		lineageTag: 65c2ed65-b953-5bfc-9776-bf9186374aa3

